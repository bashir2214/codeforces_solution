#include <iostream>
using namespace std;
int main() {
   int n = 4;
   
 int output[n] = {};
 for(int i=0;i<n;i++){
     int input;
     cin>>input;
         output[i] = input;
     }
    
 int count = 0;
 for(int i=0;i<n;i++){
     for(int j=i+1;j<n;j++){
       if(output[j]==output[i]){
         count++; 
         break;
       }  
     }
  
}
 cout<<count;
}