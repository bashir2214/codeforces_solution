#include <iostream>
using namespace std;
int  square( string str ){
    int size = str.length();
    if(size % 2!=0){
        return 0;
    }
    for(int i{};i<size/2;++i){
        if(str[i]!=str[size/2+i]){
            return 0;
        }
    }
    return 1;
}
 
int main() 
{
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        int out = square(s);
        if(out==0){
            cout<<"NO"<<endl;
        }
        else if(out==1){
            cout<<"YES"<<endl;
        }
    }
    return 0;
}